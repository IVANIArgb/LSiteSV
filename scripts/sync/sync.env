# Скопируйте в sync.env и укажите удалённый сервер.
# sync.env в .gitignore — пароли сюда не кладите, только SSH-ключ.

REMOTE_USER=deploy
REMOTE_HOST=192.168.1.50
REMOTE_PORT=22
REMOTE_PATH=/opt/learnsite

# Путь к приватному ключу SSH (пусто = стандартный ~/.ssh/id_rsa в WSL)
SSH_KEY_PATH=

# Дистрибутив WSL (wsl -l -v)
WSL_DISTRO=Ubuntu

# Локальная папка проекта (пусто = корень репозитория, родитель scripts/sync)
LOCAL_PATH=

# true = удалять на сервере файлы, которых нет локально (осторожно)
RSYNC_DELETE=false
